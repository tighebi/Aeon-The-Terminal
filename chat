#!/usr/bin/env zsh

###############################################################################
# llmchat — local Ollama chat via HTTP API
#
# Does NOT:
#   - execute model output or run any shell commands from the model
#   - access your filesystem beyond the optional memory file
#   - call any remote API by default (local by default, not enforced)
#
# Requires: zsh, curl, jq, ollama
###############################################################################

emulate -R zsh
setopt no_nomatch

PROGRAM_NAME="${0:t}"
OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"

MODEL="${LLMCHAT_MODEL:-llama3.1:8b}"
USE_HISTORY=1
MAX_HISTORY_CHARS=8000
USE_MEMORY=1
MEMORY_FILE="${CHAT_MEMORY_FILE:-${LLMCHAT_MEMORY_FILE:-$HOME/.config/chat/memory.md}}"
MEMORY_CONTEXT=""

typeset -ga CHAT_MESSAGES

SYSTEM_PROMPT="You are a local terminal assistant named Aeon.
Reply with plain text only.
You cannot run commands, inspect arbitrary files, modify files, or control the computer.
You may use only the context explicitly provided in the prompt.
If asked about shell commands, explain them but do not claim to have run them.
Be concise unless asked for more detail.
Do not be overly complimentary."

###############################################################################
# Utilities
###############################################################################

die()  { print -ru2 -- "Error: $*"; exit 1 }
have() { command -v "$1" >/dev/null 2>&1 }

usage() {
  cat <<EOF
Usage: $PROGRAM_NAME [options] [prompt]

Options:
  -m, --model MODEL      Model to use              (default: $MODEL)
  --no-history           Disable conversation history for this session
  --memory-file FILE     Persistent context file   (default: $MEMORY_FILE)
  --no-memory            Disable persistent context
  -1, --one-shot         Send one prompt and exit
  -h, --help             Show this help

Interactive commands:
  /help  /exit  /quit  /clear  /model  /history  /memory  /multiline

Environment variables:
  LLMCHAT_MODEL    Default model name
  CHAT_MEMORY_FILE Default memory file path
  OLLAMA_HOST      Ollama API base URL  (default: http://localhost:11434)
EOF
}

###############################################################################
# Startup checks
###############################################################################

ensure_deps() {
  local -a missing=()
  have curl   || missing+=(curl)
  have jq     || missing+=(jq)
  have ollama || missing+=(ollama)
  (( ${#missing} )) && die "Missing required tools: ${(j:, :)missing}"

  if ! curl -sf "${OLLAMA_HOST}/" >/dev/null 2>&1; then
    print -ru2 -- "Cannot reach Ollama at ${OLLAMA_HOST}."
    print -ru2 -- "  macOS : open the Ollama app"
    print -ru2 -- "  Linux : ollama serve"
    die "Ollama is not running."
  fi
}

ensure_model() {
  if ! curl -sf "${OLLAMA_HOST}/api/show" \
    -H 'Content-Type: application/json' \
    -d "$(jq -n --arg name "$MODEL" '{name: $name}')" \
    >/dev/null 2>&1; then

    print -- "Model '$MODEL' is not available locally."
    printf "Pull it now? (needs internet) [y/N] "
    local ans; IFS= read -r ans
    case "$ans" in
      [Yy]*) ollama pull "$MODEL" || die "Failed to pull '$MODEL'." ;;
      *)     die "Run manually: ollama pull $MODEL" ;;
    esac
  fi
}

warmup_model() {
  printf "Loading..." >&2

  jq -n --arg model "$MODEL" \
    '{model: $model, messages: [{role: "user", content: ""}], stream: false, keep_alive: "30m"}' |
    curl -sf \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${OLLAMA_HOST}/api/chat" >/dev/null 2>&1

  printf "\r\033[K" >&2   # clear the loading line
}

load_memory() {
  MEMORY_CONTEXT=""
  (( USE_MEMORY )) && [[ -r "$MEMORY_FILE" ]] && MEMORY_CONTEXT="$(<"$MEMORY_FILE")"
}

###############################################################################
# History management
###############################################################################

trim_history() {
  local joined

  while (( ${#CHAT_MESSAGES[@]} > 2 )); do
    joined="${(j::)CHAT_MESSAGES}"
    (( ${#joined} <= MAX_HISTORY_CHARS )) && break
    CHAT_MESSAGES=("${CHAT_MESSAGES[@]:2}")
  done
}

###############################################################################
# Model interaction
###############################################################################

build_payload() {
  local user_input="$1"

  local system_content="$SYSTEM_PROMPT"
  [[ -n "$MEMORY_CONTEXT" ]] && system_content+=$'\n\nPersistent context:\n'"$MEMORY_CONTEXT"

  local -a flat=("system" "$system_content")

  if (( USE_HISTORY )); then
    local i
    for (( i = 1; i <= ${#CHAT_MESSAGES[@]}; i += 2 )); do
      flat+=("user"      "${CHAT_MESSAGES[$i]}")
      flat+=("assistant" "${CHAT_MESSAGES[$((i + 1))]}")
    done
  fi

  flat+=("user" "$user_input")

  jq -n \
    --arg model "$MODEL" \
    'def to_messages:
       . as $a |
       [range(0; ($a | length); 2) as $i |
        {role: $a[$i], content: $a[$i + 1]}];
     {
       model:      $model,
       messages:   ($ARGS.positional | to_messages),
       stream:     true,
       keep_alive: "30m"
     }' \
    --args "${flat[@]}"
}

ask_model() {
  local user_input="$1"
  local response tmpfile
  local -a ps

  tmpfile="$(mktemp)" || return 1

  build_payload "$user_input" |
    curl -sf -N \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${OLLAMA_HOST}/api/chat" |
    jq --unbuffered -rj '.message.content // empty' |
    tee "$tmpfile"

  ps=("${pipestatus[@]}")

  response="$(<"$tmpfile")"
  rm -f "$tmpfile"

  printf '\n'

  if (( ps[1] != 0 || ps[2] != 0 || ps[3] != 0 || ps[4] != 0 )); then
    return 1
  fi

  if [[ -z "$response" ]]; then
    return 1
  fi

  if (( USE_HISTORY )); then
    CHAT_MESSAGES+=("$user_input" "$response")
    trim_history
  fi

  return 0
}

###############################################################################
# Interactive mode
###############################################################################

cmd_help() {
  cat <<'EOF'

  /help       This message
  /exit       Exit
  /quit       Exit
  /clear      Clear session history
  /model      Show current model
  /history    Show history status
  /memory     Show memory file status
  /multiline  Enter multiline input; end with '.' on its own line

EOF
}

read_multiline() {
  local line text=""
  print -- "Multiline input — finish with '.' on its own line."
  while true; do
    printf "... "
    IFS= read -r line || break
    [[ "$line" == "." ]] && break
    text+="$line"$'\n'
  done
  REPLY="$text"
}

run_chat() {
  print -- "Aeon — /help for commands, /exit to quit."
  print -- ""

  local input
  while true; do
    printf "You> "
    IFS= read -r input || { print -- ""; print -- "Goodbye."; break }

    case "$input" in
      "")          continue ;;
      /exit|/quit) print -- "Goodbye."; break ;;
      /help)       cmd_help; continue ;;

      /clear)
        CHAT_MESSAGES=()
        print -- "History cleared."
        continue
        ;;

      /model)
        print -- "Model: $MODEL"
        continue
        ;;

      /history)
        if (( USE_HISTORY )); then
          local pairs=$(( ${#CHAT_MESSAGES[@]} / 2 ))
          local joined="${(j::)CHAT_MESSAGES}"
          print -- "History: enabled — $pairs exchanges, ${#joined} / $MAX_HISTORY_CHARS chars"
        else
          print -- "History: disabled"
        fi
        continue
        ;;

      /memory)
        if (( USE_MEMORY )); then
          print -- "File   : $MEMORY_FILE"
          if [[ -r "$MEMORY_FILE" ]]; then
            print -- "Status : loaded (${#MEMORY_CONTEXT} chars)"
          else
            print -- "Status : not found or not readable"
          fi
        else
          print -- "Memory: disabled"
        fi
        continue
        ;;

      /multiline)
        read_multiline
        input="$REPLY"
        [[ -z "$input" ]] && continue
        ;;
    esac

    printf "\nAeon>\n"
    ask_model "$input" || print -ru2 -- "Request failed."
    print -- ""
  done
}

###############################################################################
# Argument parsing
###############################################################################

ONE_SHOT=0
typeset -ga POSITIONAL

while (( $# )); do
  case "$1" in
    -m|--model)
      shift; [[ $# -gt 0 ]] || die "Missing value for --model"
      MODEL="$1"
      ;;
    --no-history)  USE_HISTORY=0 ;;
    --memory-file)
      shift; [[ $# -gt 0 ]] || die "Missing value for --memory-file"
      MEMORY_FILE="$1"
      ;;
    --no-memory)   USE_MEMORY=0 ;;
    -1|--one-shot) ONE_SHOT=1 ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; POSITIONAL+=("$@"); break ;;
    -*)            die "Unknown option: $1" ;;
    *)             POSITIONAL+=("$1") ;;
  esac
  shift
done

###############################################################################
# Main
###############################################################################

ensure_deps
ensure_model
warmup_model
load_memory

(( ${#POSITIONAL} )) && ONE_SHOT=1

if (( ONE_SHOT )); then
  (( ${#POSITIONAL} )) || die "One-shot mode requires a prompt."
  ask_model "${(j: :)POSITIONAL}" || die "Request failed."
  exit 0
fi

run_chat
#!/usr/bin/env zsh

###############################################################################
# llmchat
#
# A local-only terminal LLM chat script for zsh using Ollama.
#
# This script:
#   - sends your text to a local Ollama model
#   - prints the model's response
#   - optionally keeps conversation history during the session
#
# This script does NOT:
#   - execute model output
#   - run shell commands suggested by the model
#   - give the model access to your filesystem
#   - call any remote API during normal use
#
# Requirements:
#   - zsh
#   - ollama
#   - a pulled local model, for example:
#       ollama pull llama3.1:8b-instruct
###############################################################################

emulate -R zsh
setopt no_nomatch

PROGRAM_NAME="${0:t}"

# Default model.
# You can override this with:
#   LLMCHAT_MODEL="qwen2.5:7b-instruct" ./llmchat
# or:
#   ./llmchat --model qwen2.5:7b-instruct
MODEL="${LLMCHAT_MODEL:-llama3.1:8b}"

# Keep short-term chat history by default.
USE_HISTORY=1

# Maximum number of characters to keep in the session history.
# This prevents prompts from growing forever.
MAX_HISTORY_CHARS=16000

# Internal conversation transcript.
CHAT_HISTORY=""

SYSTEM_PROMPT="
You are a local terminal-based language model assistant named Aeon.
You respond with text only.
You cannot run commands, execute programs, inspect files, modify files, access devices, or control the computer.
If the user asks for commands, you may explain them, but you must not claim to have run them.
Be concise unless the user asks for detail.
Do not be overly complemantary or flowery with your responses.
"

# Persistent local context file.
# This is read and included in every prompt if it exists.
USE_MEMORY=1
MEMORY_FILE="${CHAT_MEMORY_FILE:-${LLMCHAT_MEMORY_FILE:-$HOME/.config/chat/memory.md}}"

###############################################################################
# Utility functions
###############################################################################

usage() {
  cat <<EOF
Usage:
  $PROGRAM_NAME [options]
  $PROGRAM_NAME [options] "prompt here"

Options:
  -m, --model MODEL      Use a different Ollama model
  --no-history          Do not keep conversation history
  -1, --one-shot        Run one prompt and exit
  -h, --help            Show this help message
  --memory-file FILE    Use a different persistent context file
  --no-memory           Disable persistent context file

Interactive commands:
  /help                 Show interactive help
  /exit, /quit          Exit the chat
  /clear                Clear session history
  /model                Show current model
  /history              Show whether history is enabled
  /memory               Show persistent memory/context status
  /multiline            Enter a multiline prompt; finish with a single dot '.'

Examples:
  $PROGRAM_NAME
  $PROGRAM_NAME "Explain recursion simply."
  $PROGRAM_NAME --model qwen2.5:7b-instruct
  $PROGRAM_NAME --no-history

Environment variables:
  LLMCHAT_MODEL         Default model name
  CHAT_MEMORY_FILE      Persistent context file path
EOF
}

die() {
  print -ru2 -- "Error: $*"
  exit 1
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

ensure_ollama_available() {
  if ! have_command ollama; then
    die "Ollama is not installed or not in PATH. Install it from https://ollama.com"
  fi

  if ! ollama list >/dev/null 2>&1; then
    print -ru2 -- "Could not connect to Ollama."
    print -ru2 -- ""
    print -ru2 -- "Try one of these:"
    print -ru2 -- "  - On macOS, open the Ollama app."
    print -ru2 -- "  - On Linux, run: ollama serve"
    print -ru2 -- ""
    die "Ollama is installed, but the local Ollama service is not reachable."
  fi
}

ensure_model_available() {
  if ollama show "$MODEL" >/dev/null 2>&1; then
    return 0
  fi

  print -- "Model '$MODEL' is not currently available locally."
  print -- ""
  print -- "You can download it with:"
  print -- "  ollama pull $MODEL"
  print -- ""

  printf "Pull it now? This requires an internet connection. [y/N] "
  local answer
  IFS= read -r answer

  case "$answer" in
    [Yy]|[Yy][Ee][Ss])
      ollama pull "$MODEL" || die "Failed to pull model '$MODEL'."
      ;;
    *)
      die "Model '$MODEL' is required. Pull it manually with: ollama pull $MODEL"
      ;;
  esac
}

trim_history_if_needed() {
  if (( ${#CHAT_HISTORY} > MAX_HISTORY_CHARS )); then
    CHAT_HISTORY=$'[earlier conversation trimmed]\n'"${CHAT_HISTORY[-$MAX_HISTORY_CHARS,-1]}"
  fi
}

build_prompt() {
  local user_input="$1"
  local memory_context=""

  if (( USE_MEMORY )) && [[ -r "$MEMORY_FILE" ]]; then
    memory_context="$(<"$MEMORY_FILE")"
  fi

  if (( USE_HISTORY )); then
    if [[ -n "$memory_context" ]]; then
      cat <<EOF
$SYSTEM_PROMPT

Persistent user context:
$memory_context

Conversation so far:
$CHAT_HISTORY

User:
$user_input

Assistant:
EOF
    else
      cat <<EOF
$SYSTEM_PROMPT

Conversation so far:
$CHAT_HISTORY

User:
$user_input

Assistant:
EOF
    fi
  else
    if [[ -n "$memory_context" ]]; then
      cat <<EOF
$SYSTEM_PROMPT

Persistent user context:
$memory_context

User:
$user_input

Assistant:
EOF
    else
      cat <<EOF
$SYSTEM_PROMPT

User:
$user_input

Assistant:
EOF
    fi
  fi
}

ask_model() {
  local user_input="$1"
  local full_prompt
  local response
  local tmpfile
  local rc
  local -a pipe_rc

  full_prompt="$(build_prompt "$user_input")"

  tmpfile="${TMPDIR:-/tmp}/chat-response-$$-$RANDOM.txt"

  ollama run "$MODEL" "$full_prompt" | tee "$tmpfile"

  pipe_rc=("${pipestatus[@]}")
  rc="${pipe_rc[1]}"

  if (( rc != 0 )); then
    rm -f "$tmpfile"
    return "$rc"
  fi

  response="$(<"$tmpfile")"
  rm -f "$tmpfile"

  if (( USE_HISTORY )); then
    CHAT_HISTORY+=$'\nUser:\n'
    CHAT_HISTORY+="$user_input"
    CHAT_HISTORY+=$'\n\nAssistant:\n'
    CHAT_HISTORY+="$response"
    CHAT_HISTORY+=$'\n'
    trim_history_if_needed
  fi

  return 0
}

interactive_help() {
  cat <<EOF

Commands:
  /help       Show this help
  /exit       Exit the chat
  /quit       Exit the chat
  /clear      Clear this session's conversation history
  /model      Show the current model
  /history    Show whether session history is enabled
  /multiline  Enter multiline mode; finish with a single line containing only '.'

Notes:
  - The model is local through Ollama.
  - The model's text is only printed.
  - The model cannot execute shell commands from this script.

EOF
}

read_multiline_prompt() {
  local line
  local text=""

  print -- "Enter multiline prompt."
  print -- "Finish with a single line containing only a dot:"
  print -- "."

  while true; do
    printf "... "
    IFS= read -r line || break

    if [[ "$line" == "." ]]; then
      break
    fi

    text+="$line"$'\n'
  done

  REPLY="$text"
}

run_interactive_chat() {
  print -- "Type /help for commands. Type /exit to quit."
  print -- ""

  local user_input

  while true; do
    printf "You> "
    IFS= read -r user_input

    if (( $? != 0 )); then
      print -- ""
      print -- "Goodbye."
      break
    fi

    case "$user_input" in
      "")
        continue
        ;;

      "/exit"|"/quit")
        print -- "Goodbye."
        break
        ;;

      "/help")
        interactive_help
        continue
        ;;

      "/clear")
        CHAT_HISTORY=""
        print -- "Session history cleared."
        continue
        ;;

      "/model")
        print -- "Current model: $MODEL"
        continue
        ;;

      "/history")
        if (( USE_HISTORY )); then
          print -- "History: enabled"
          print -- "Stored characters: ${#CHAT_HISTORY}"
          print -- "Maximum characters: $MAX_HISTORY_CHARS"
        else
          print -- "History: disabled"
        fi
        continue
        ;;

      "/memory")
        if (( USE_MEMORY )); then
          print -- "Memory: enabled"
          print -- "Memory file: $MEMORY_FILE"

          if [[ -r "$MEMORY_FILE" ]]; then
            print -- "Status: readable"
            print -- "Characters: $(wc -m < "$MEMORY_FILE" | tr -d ' ')"
          else
            print -- "Status: not found or not readable"
          fi
        else
          print -- "Memory: disabled"
        fi
        continue
        ;;

      "/multiline")
        read_multiline_prompt
        user_input="$REPLY"

        if [[ -z "$user_input" ]]; then
          continue
        fi
        ;;
    esac

    print -- ""
    print -- "Aeon>"
    if ! ask_model "$user_input"; then
      print -ru2 -- "Error: model request failed."
    fi
    print -- ""
  done
}

###############################################################################
# Argument parsing
###############################################################################

ONE_SHOT=0
POSITIONAL=()

while (( $# > 0 )); do
  case "$1" in
    -m|--model)
      shift
      [[ $# -gt 0 ]] || die "Missing model name after --model"
      MODEL="$1"
      ;;

    --no-history)
      USE_HISTORY=0
      ;;

    --memory-file)
      shift
      [[ $# -gt 0 ]] || die "Missing file path after --memory-file"
      MEMORY_FILE="$1"
      ;;

    --no-memory)
      USE_MEMORY=0
      ;;

    -1|--one-shot)
      ONE_SHOT=1
      ;;

    -h|--help)
      usage
      exit 0
      ;;

  

    --)
      shift
      while (( $# > 0 )); do
        POSITIONAL+=("$1")
        shift
      done
      break
      ;;

    -*)
      die "Unknown option: $1"
      ;;

    *)
      POSITIONAL+=("$1")
      ;;
  esac

  shift
done

###############################################################################
# Main
###############################################################################

ensure_ollama_available
ensure_model_available

if (( ${#POSITIONAL} > 0 )); then
  ONE_SHOT=1
fi

if (( ONE_SHOT )); then
  if (( ${#POSITIONAL} == 0 )); then
    die "One-shot mode requires a prompt."
  fi

  USER_PROMPT="${(j: :)POSITIONAL}"

  if ! ask_model "$USER_PROMPT"; then
    die "Model request failed."
  fi

  exit 0
fi

run_interactive_chat